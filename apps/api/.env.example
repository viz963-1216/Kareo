# Kareo Backend API — Environment Variables (placeholder only, no real values)
# 禁止在此檔案或任何 commit 中放入真實 Secret。
# 正式值由 Jerry 於部署環境（Netlify / Supabase Dashboard）設定。

# Supabase project URL
SUPABASE_URL=

# Supabase anon (public) key — 前端可安全使用的 key，本專案由 Backend 統一管理
SUPABASE_ANON_KEY=

# Supabase service role key — 僅可存在 Server-side Environment Variable，絕不可暴露給前端
SUPABASE_SERVICE_ROLE_KEY=
