      "id": "KREC-MURI6V2ROK9EFL3F",
      "title": "可申請長照服務的資格",
      "source": {
        "url": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=L0070059",
        "title": "長期照顧服務申請及給付辦法（條文）",
        "publisher": "LAW"
      },
      "summary": "因身心失能，且符合 65 歲以上（原住民 55 歲以上）、領有身心障礙證明、失智症，或符合急性後期整合照護計畫收案對象其中之一者，可向照管中心或地方主管機關申請；是否符合給付仍以照管專員評估核定為準。",
      "category": "ELIGIBILITY",
      "ruleData": {
        "type": "ELIGIBILITY_ANY_OF",
        "criteria": [
          {
            "code": "AGE_65_PLUS"
          },
          {
            "code": "INDIGENOUS_AGE_55_PLUS"
          },
          {
            "code": "DISABILITY_CERTIFICATE"
          },
          {
            "code": "DEMENTIA",
            "effectiveFrom": "2026-01-01"
          },
          {
            "code": "PAC_PROGRAM",
            "effectiveFrom": "2026-01-01"
          }
        ],
        "excludes": [
          "FULL_RESIDENTIAL_SERVICE",
          "GROUP_HOME"
        ],
        "requiresDisability": true
      },
      "authority": "LAW",
      "effectiveTo": null,
      "jurisdiction": "TAIWAN",
      "packRecordId": "KR-2026-001",
      "effectiveFrom": "2026-01-01",
      "lastVerifiedAt": "2026-09-23T02:40:00+00:00"
    },
